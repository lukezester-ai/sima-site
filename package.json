{
  "name": "agrinexus-geo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "test": "node --check server.js && npm run lint:ci && node scripts/verify-no-cloudflare.mjs && node scripts/smoke-server.mjs",
    "predev": "npm run build:react",
    "prestart": "npm run build:react",
    "start": "node server.js",
    "dev": "node server.js",
    "build:react": "vite build",
    "build:logo": "node scripts/rasterize-logo.mjs",
    "build:pwa-icons": "node scripts/build-pwa-icons.mjs",
    "build:assets": "npm run build:logo && npm run build:pwa-icons && npm run build:react",
    "seed:db": "node scripts/copy-seed-db.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.6.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.21"
  }
}
