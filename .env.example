# HTTP порт (по подразбиране 3001)
PORT=3001

# Публичен адрес на сайта (за правилни URL в robots.txt и sitemap.xml).
# Пример: https://www.agrinexus.eu — без накраен /
# PUBLIC_ORIGIN=https://www.agrinexus.eu

# Единствен публичен контакт (ползва се и в записите от формата): info@agrinexus.eu
# Зад HTTPS reverse proxy задавайте 1, за да се ползва https във вътрешни генерирани връзки:
# PUBLIC_HTTPS=1

# --- Field Watch LLM (по подробно: LLM-CONFIG.md) ---
# Без тези променливи: demo режим с локален fallback анализ.
# LLM_PROVIDER=demo

# Mistral AI (чат + препоръчително същият ключ за RAG embeddings)
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your_mistral_key
# По желание (има разумни подразбирания):
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# За OpenAI-съвместим API:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# За Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.2

# --- RAG (Retrieval-Augmented Generation) за Field Watch ---
# Използва OpenAI-съвместим POST .../embeddings (OpenAI, Mistral и др.).
# По подразбиране: същият ключ/base като за LLM; при MISTRAL_API_KEY → mistral-embed.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# RAG_EMBEDDING_MODEL=mistral-embed
# RAG_TOP_K=6
# RAG_MAX_CHUNKS_PER_INGEST=48
# RAG_INDEX_MAX_CHUNKS=8000
