# Сървърът зарежда автоматично `.env` и `.env.local` от корена на проекта (освен на Vercel).
# В производство задайте променливите чрез средата (PM2 / systemd / Docker / Vercel UI).

# HTTP порт (по подразбиране 3001)
PORT=3001

# Публичен адрес на сайта (за правилни URL в robots.txt и sitemap.xml).
# Пример: https://www.agrinexus.eu — без накраен /
# PUBLIC_ORIGIN=https://www.agrinexus.eu

# Единствен публичен контакт (ползва се и в записите от формата): info@agrinexus.eu
# Зад HTTPS reverse proxy задавайте 1, за да се ползва https във вътрешни генерирани връзки
# и да се добави Strict-Transport-Security:
# PUBLIC_HTTPS=1

# --- Лимити на заявките ---
# Максимален размер на JSON тяло (байтове, по подразбиране 1 000 000)
# MAX_JSON_BYTES=1000000

# --- Anti-bot (публични POST от сайта) ---
# Списък с допълнителни разрешени Origin-и (запетая), без накраен /. Напр. https://www.example.com
# GEO_ALLOWED_ORIGINS=https://preview.example.com
# За локални тестове с curl/Postman без Origin: 1 = изключва проверката на Origin/Referer
# GEO_RELAX_BROWSER_ORIGIN=1
# Минимално време от зареждане на формата до изпращане (ms). По подразбиране 1300.
# GEO_FORM_MIN_MS=1300
# Максимална „възраст“ на formOpenedAt (ms). По подразбиране 24 часа.
# GEO_FORM_MAX_MS=86400000

# Максимален размер на multipart upload (байтове, по подразбиране 25 MB)
# MAX_UPLOAD_BYTES=26214400

# --- Persistent storage (Vercel KV / Upstash Redis REST) ---
# По подразбиране db.json и contact-inquiries.json се пишат на диска
# (`data/` локално, `/tmp/` на Vercel — където НЕ са persistent).
#
# За продакшън на Vercel: създайте KV store в Vercel Dashboard
# (Storage -> Create Database -> KV) и го свържете с проекта. Vercel
# автоматично добавя нужните env vars в Environment Variables.
# Тогава users, sessions, fields и т.н. ще оцеляват между deploy-и.
#
# KV_REST_API_URL=https://your-store.upstash.io
# KV_REST_API_TOKEN=AXXXxxxxxxxxxxxxxxxxxxxxxxxxxx
# (при Redis от Marketplace понякога са UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN — сървърът ги приема също)
# По желание: имена на ключовете в KV (по подразбиране geo:db и geo:contact-inquiries)
# KV_DB_KEY=geo:db
# KV_INQUIRIES_KEY=geo:contact-inquiries


# --- Карта в портала (раздел "Полета") ---
# По подразбиране: безплатни OSM tiles от tile.openstreetmap.org. Това НЕ е
# подходящо за production (виж OSM Tile Usage Policy). За реално натоварване
# препоръчваме провайдър с API ключ, заключен по domain в техния dashboard.
#
# Пример: MapTiler (https://cloud.maptiler.com — 100k заявки/месец free)
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# MAP_MAX_ZOOM=20
#
# Пример: Mapbox (https://www.mapbox.com — 50k MAU free)
# MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}@2x?access_token=YOUR_MAPBOX_TOKEN
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.mapbox.com/about/maps/">Mapbox</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
#
# Пример: Stadia Maps (https://stadiamaps.com — безплатно за non-commercial)
# MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}.png?api_key=YOUR_STADIA_KEY
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- Сателитен слой (по желание) ---
# Ако е зададен, в toolbar-а на картата се появява бутон "Сателит / Улици".
#
# Пример: MapTiler Satellite
# MAP_SATELLITE_TILE_URL=https://api.maptiler.com/maps/satellite/256/{z}/{x}/{y}.jpg?key=YOUR_MAPTILER_KEY
# MAP_SATELLITE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a>
# MAP_SATELLITE_MAX_ZOOM=20
#
# Пример: ESRI World Imagery (без ключ, но виж terms)
# MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri &mdash; Source: Esri, Maxar, Earthstar Geographics
# MAP_SATELLITE_MAX_ZOOM=19

# --- Терен (релеф) — по желание ---
# Когато е зададен, в toolbar-а на картата се появява бутон "Терен", който
# включва 2D hillshade (сянка) + 3D наклон (drag с десен бутон).
# Encoding: "terrarium" (AWS) или "mapbox" (MapTiler/Mapbox Terrain-RGB).
#
# Пример: AWS Terrain Tiles (без ключ — публично, безплатно)
# MAP_TERRAIN_TILE_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
# MAP_TERRAIN_ENCODING=terrarium
# MAP_TERRAIN_ATTRIBUTION=Terrain &copy; <a href="https://registry.opendata.aws/terrain-tiles/">AWS Terrain Tiles</a>
# MAP_TERRAIN_MAX_ZOOM=15
#
# Пример: MapTiler Terrain-RGB (с ключ)
# MAP_TERRAIN_TILE_URL=https://api.maptiler.com/tiles/terrain-rgb-v2/{z}/{x}/{y}.webp?key=YOUR_MAPTILER_KEY
# MAP_TERRAIN_ENCODING=mapbox
# MAP_TERRAIN_ATTRIBUTION=&copy; MapTiler

# --- Метео radar overlay — по желание ---
# Появява се по един toggle бутон за всеки активен слой ("Дъжд", "Облаци" и т.н.).
#
# Вариант A: RainViewer (без ключ, само радар, авто-refresh на 5 мин)
# WEATHER_PROVIDER=rainviewer
#
# Вариант B: OpenWeatherMap (с ключ, повече слоеве)
# Free: 1000 заявки/ден.
# WEATHER_PROVIDER=openweathermap
# OPENWEATHERMAP_API_KEY=your_owm_key
# По подразбиране активни: precipitation, clouds. Може да укажете други/повече:
# Възможни стойности: precipitation, clouds, temp, wind, pressure
# WEATHER_LAYERS=precipitation,clouds,temp,wind

# --- Field Watch + портален AI чат (LLM-CONFIG.md) ---
# Без LLM ключ: demo fallback за Field Watch; чатът връща грешка.
#
# Препоръка за SIMA (сайт): Mistral — един ключ за чат и RAG embeddings.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_key
# LLM_MODEL=mistral-small-latest

# Z.AI Open Platform (glm-5.1) — отделен API баланс; не Coding Lite план
# LLM_PROVIDER=zai
# ZAI_API_KEY=your_z_ai_key
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_MODEL=glm-5.1
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.7
# LLM_THINKING=1
# RAG embeddings: отделно задайте MISTRAL_API_KEY или OPENAI + EMBEDDING_BASE_URL (Z.AI няма embeddings тук)

# По желание:
# LLM_BASE_URL=https://api.mistral.ai/v1
# RAG_EMBEDDING_MODEL=mistral-embed

# За OpenAI-съвместим API:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# За Ollama:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=llama3.2

# --- RAG (Retrieval-Augmented Generation) за Field Watch ---
# Използва OpenAI-съвместим POST .../embeddings (OpenAI, Mistral и др.).
# По подразбиране: същият ключ/base като за LLM; при MISTRAL_API_KEY → mistral-embed.
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.mistral.ai/v1
# RAG_EMBEDDING_MODEL=mistral-embed
# RAG_TOP_K=6
# RAG_MAX_CHUNKS_PER_INGEST=48
# RAG_INDEX_MAX_CHUNKS=8000
